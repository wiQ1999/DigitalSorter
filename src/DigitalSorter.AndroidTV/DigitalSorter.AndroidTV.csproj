<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RootNamespace>DigitalSorter.AndroidTV</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>DigitalSorter Android TV</ApplicationTitle>
    <ApplicationId>pl.wiq1999.digitalsorter.androidtv</ApplicationId>
    <ApplicationDisplayVersion>0.8.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="../DigitalSorter.Web/wwwroot/icon.svg" ForegroundScale="0.65" />
    <MauiSplashScreen Include="../DigitalSorter.Web/wwwroot/icon.svg" Color="#0b1018" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\tv_banner.svg" BaseSize="320,180" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(DigitalSorterTestCertificate)' != ''">
    <AndroidManifestOverlay Include="../../tests/native/AndroidManifest.xml" />
    <AndroidResource Include="$(DigitalSorterTestCertificate)" LogicalName="raw/digitalsorter_test_ca.pem" />
    <AndroidResource Include="../../tests/native/network_security_config.xml" LogicalName="xml/digitalsorter_test_network.xml" />
  </ItemGroup>
  <Target Name="RejectReleaseTestCertificate" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' != 'Debug' and '$(DigitalSorterTestCertificate)' != ''">
    <Error Text="A controlled test certificate is allowed only in Debug builds." />
  </Target>

</Project>
